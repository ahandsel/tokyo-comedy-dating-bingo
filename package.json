{
  "name": "tokyo-comedy-dating-bingo",
  "version": "1.0.0",
  "private": true,
  "description": "Tinder-style swiping meets 5x5 Bingo. A bilingual (EN/JA) party game about Tokyo dating life.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "dev": "vite",
    "index": "zsh scripts/index.sh",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-code": "prettier --write .",
    "lint-md": "markdownlint-cli2 --fix \"**/*.md\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@lucide/vue": "^1.64.0",
    "canvas-confetti": "^1.9.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.4",
    "markdownlint-rule-search-replace": "^1.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-autocorrect": "^0.4.3",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^3.0.2",
    "sh-syntax": "^0.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  }
}
