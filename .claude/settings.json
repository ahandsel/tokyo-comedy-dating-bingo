{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryDirectory": "./memory",
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(corepack --version)",
      "Bash(corepack enable:*)",
      "Bash(corepack use:*)",
      "Bash(echo:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo view)",
      "Bash(git add:*)",
      "Bash(git branch)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git remote -v)",
      "Bash(git restore:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status)",
      "Bash(grep -v:*)",
      "Bash(node skills/ai-commit/scripts/apply-commit-plan.mjs:*)",
      "Bash(node skills/ai-commit/scripts/apply-commit.mjs:*)",
      "Bash(node skills/ai-commit/scripts/gather-commit-context.mjs:*)",
      "Bash(node skills/ai-commit/scripts/lib/commit-utils.mjs:*)",
      "Bash(node skills/ai-commit/scripts/validate-commit-message.mjs:*)",
      "Bash(node skills/file-folder-name-linter/scripts/lint-names.mjs:*)",
      "Bash(node skills/gh-address-comments/scripts/fetch-pr-comments.mjs:*)",
      "Bash(node skills/gh-fix-ci/scripts/inspect-pr-checks.mjs:*)",
      "Bash(node skills/gh-pr-reporter/scripts/get-pr-comments.mjs:*)",
      "Bash(node skills/gh-sync-with-main/scripts/update-branch-from-main.mjs:*)",
      "Bash(node skills/script-auditor/scripts/audit-helper-scripts.mjs:*)",
      "Bash(node skills/skill-allowlist-syncer/scripts/check-skill-allowlist.mjs:*)",
      "Bash(nodenv version:*)",
      "Bash(nodenv versions:*)",
      "Bash(pnpm --version)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm config:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm index:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint-code:*)",
      "Bash(pnpm lint-md:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm prettier:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(zsh scripts/index.sh:*)",
      "Skill(ai-commit)",
      "Skill(file-folder-name-linter)",
      "Skill(general-en-polisher)",
      "Skill(gh-address-comments)",
      "Skill(gh-cli)",
      "Skill(gh-fix-ci)",
      "Skill(gh-pr-generator)",
      "Skill(gh-pr-reporter)",
      "Skill(gh-sync-with-main)",
      "Skill(ja-review-text)",
      "Skill(pr-auditor)",
      "Skill(readability-editor)",
      "Skill(readme-maintainer)",
      "Skill(script-auditor)",
      "Skill(security-best-practices)",
      "Skill(security-threat-model)",
      "Skill(skill-allowlist-syncer)",
      "WebFetch(domain:ahandsel.github.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:vue-i18n.intlify.dev)",
      "WebFetch(domain:vuejs.org)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(node skills/ai-commit/scripts/apply-commit-plan.mjs:*)",
      "Bash(node skills/ai-commit/scripts/apply-commit.mjs:*)",
      "Bash(node skills/file-folder-name-linter/scripts/lint-names.mjs --fix:*)",
      "Bash(node skills/gh-sync-with-main/scripts/update-branch-from-main.mjs:*)",
      "Bash(node skills/skill-allowlist-syncer/scripts/check-skill-allowlist.mjs --write:*)",
      "Bash(npx:*)",
      "Bash(pnpm dlx:*)",
      "Bash(wget:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Read(.env)",
      "Read(.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint"
          }
        ]
      }
    ]
  }
}
